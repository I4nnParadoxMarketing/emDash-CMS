# Database (required on Vercel — use Turso or another libSQL provider)
# Create a free database at https://turso.tech
LIBSQL_DATABASE_URL=libsql://your-database.turso.io
LIBSQL_AUTH_TOKEN=your-turso-auth-token

# Session store (required for EmDash admin on Vercel)
# Create Vercel KV or Upstash Redis and connect to your project
KV_REST_API_URL=https://your-kv.upstash.io
KV_REST_API_TOKEN=your-kv-token

# EmDash encryption (generate with: npx emdash secrets generate)
EMDASH_ENCRYPTION_KEY=emdash_enc_v1_your-key-here

# Optional: S3-compatible media storage (recommended for production)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_PUBLIC_URL=
