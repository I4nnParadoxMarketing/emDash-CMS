---
import { getEmDashCollection } from "emdash";

interface Props {
	node: {
		_key?: string;
		headline?: string;
		subheadline?: string;
	};
}

const { node } = Astro.props;
const { _key, headline, subheadline } = node;

const { entries: faqs, cacheHint } = await getEmDashCollection("faqs", {
	status: "published",
	orderBy: { sort_order: "asc" },
	limit: 50,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<section class="faq section" id={_key ?? "faq"}>
	<div class="container">
		{(headline || subheadline) && (
			<header class="section-header">
				{headline && <h2 class="section-headline">{headline}</h2>}
				{subheadline && <p class="section-subheadline">{subheadline}</p>}
			</header>
		)}
		{faqs.length > 0 ? (
			<div class="faq-list">
				{faqs.map((faq) => (
					<details class="faq-item" name="faq">
						<summary class="faq-question">
							<span>{faq.data.question}</span>
							<svg
								class="faq-icon"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								aria-hidden="true"
							>
								<path d="M6 9l6 6 6-6" />
							</svg>
						</summary>
						<div class="faq-answer">
							<p>{faq.data.answer}</p>
						</div>
					</details>
				))}
			</div>
		) : (
			<p class="faq-empty">Add FAQs in the EmDash admin to populate this section.</p>
		)}
	</div>
</section>

<style>
	.faq-list {
		max-width: var(--max-width);
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
	}

	.faq-item {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		overflow: hidden;
		transition: border-color var(--transition-fast);
	}

	.faq-item:hover {
		border-color: var(--color-brand-soft);
	}

	.faq-item[open] {
		border-color: var(--color-brand);
	}

	.faq-question {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-md);
		padding: var(--spacing-lg) var(--spacing-xl);
		font-size: var(--font-size-base);
		font-weight: 600;
		cursor: pointer;
		list-style: none;
		color: var(--color-brand-strong);
	}

	.faq-question::-webkit-details-marker {
		display: none;
	}

	.faq-icon {
		width: 20px;
		height: 20px;
		flex-shrink: 0;
		color: var(--color-brand);
		transition: transform var(--transition-base);
	}

	.faq-item[open] .faq-icon {
		transform: rotate(180deg);
	}

	.faq-answer {
		padding: 0 var(--spacing-xl) var(--spacing-lg);
	}

	.faq-answer p {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		line-height: var(--leading-relaxed);
	}

	.faq-empty {
		text-align: center;
		color: var(--color-muted);
		padding: var(--spacing-2xl);
		background: var(--color-surface);
		border-radius: var(--radius-lg);
	}
</style>
